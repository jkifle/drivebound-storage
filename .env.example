POSTGRES_DB=photos
POSTGRES_USER=photos
POSTGRES_PASSWORD=change-me
ENVIRONMENT=development
DEPLOYMENT_MODE=hybrid
CONTROL_PLANE_URL=
DATABASE_URL=postgresql+asyncpg://photos:change-me@postgres:5432/photos
REDIS_URL=redis://redis:6379/0
ORIGINALS_PATH=/data/originals
DERIVATIVES_PATH=/data/derivatives
STAGING_PATH=/data/staging
REPLICA_PATH=/data/replicas
REPLICA_ROOTS=/data/replicas
BACKUPS_PATH=/data/backups
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_INTERVAL_HOURS=24
DATABASE_BACKUP_RETENTION_DAYS=30
LIFECYCLE_RETENTION_DAYS=30
AUTO_PROTECT_UPLOADS=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EXTERNAL_LIBRARY_ROOTS=/data/imports
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
JWT_SECRET=replace-with-a-long-random-secret-before-remote-access
AUTH_COOKIE_NAME=drivebound_session
AUTH_COOKIE_SECURE=false
REFRESH_COOKIE_NAME=drivebound_refresh
ACCESS_TOKEN_MINUTES=15
REFRESH_SESSION_DAYS=30
EMAIL_DELIVERY_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Drivebound <noreply@drivebound.local>
SMTP_USE_TLS=true
MFA_ENCRYPTION_SECRET=replace-with-an-independent-long-random-secret
AUTH_RATE_LIMIT_ATTEMPTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Drivebound
WEBAUTHN_ORIGINS=http://localhost:3000
WEBAUTHN_CHALLENGE_MINUTES=5
RECENT_AUTH_MINUTES=10
REMOTE_ACCESS_ENABLED=false
TRUSTED_HOSTS=localhost,127.0.0.1
# Only direct peers in these CIDRs may supply X-Forwarded-For. Leave empty
# without a trusted reverse proxy; never use 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=
SEMANTIC_ENABLED=true
OCR_ENABLED=true
MONITOR_INTERVAL_SECONDS=900
MEDIA_ENCRYPTION_ENABLED=true
# Generate a unique key before staging/production with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production uses MEDIA_ENCRYPTION_MASTER_KEY_FILE instead of this setting.
MEDIA_ENCRYPTION_MASTER_KEY=RZAIpFM5CAciKTy4UABCTvvyD83LfeB9r_ZR4z0LnKQ=
MEDIA_ENCRYPTION_MIGRATE_LEGACY=false
OBSERVABILITY_LOG_JSON=false
# Required for remote/staging/production deployments. Send as a Bearer token
# when scraping /metrics. Production uses METRICS_AUTH_TOKEN_FILE instead.
METRICS_AUTH_TOKEN=
